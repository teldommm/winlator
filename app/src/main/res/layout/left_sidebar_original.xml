<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:background="#000000">

        <LinearLayout
            android:id="@+id/BTItemGraphics"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_gpu"
                app:tint="#0055ff" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/BTItemScreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_effects"
                app:tint="#0055ff" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/BTItemInput"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/icon_mouse"
                app:tint="#0055ff" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/BTItemFPS"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_performance"
                app:tint="#0055ff" />
        </LinearLayout>

        <View
            android:layout_width="38dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/sidebar_field" />

        <LinearLayout
            android:id="@+id/BTItemTaskManager"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_task_manager"
                app:tint="#0055ff" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/BTItemPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/icon_pause"
                app:tint="#0055ff" />
        </LinearLayout>

        <TextView
            android:id="@+id/TVPause"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/BTItemMouse"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/BTItemExit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_exit">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_power"
                app:tint="#FF5252" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@drawable/sidebar_field" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/sidebar_panel_bg"
        android:elevation="8dp"
        android:paddingStart="18dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <ScrollView
            android:id="@+id/LLSubGraphics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rendering"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/LLRuntimeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/sidebar_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Runtime Status"
                        android:textColor="?attr/ingameSidebarOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/TVRuntimeRendererStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?attr/ingameSidebarOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/TVRuntimeDXWrapperStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/ingameSidebarOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/TVRuntimeGLDriverStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/ingameSidebarOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/TVRuntimeUpscalerStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/ingameSidebarOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/TVRuntimeFramegenStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/ingameSidebarOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/TVRuntimeFEXCoreStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/ingameSidebarOnSurfaceVariant"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/TVRuntimeUnixLibsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/ingameSidebarOnSurfaceVariant"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="92dp"
                        android:layout_height="wrap_content"
                        android:text="FPS Limiter"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <Spinner
                        android:id="@+id/SPNativeFPS"
                        android:layout_width="105dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/sidebar_spinner" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/LLStandardOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:background="@drawable/sidebar_card"
                    android:padding="12dp">
                    <Switch
                        android:id="@+id/SWEnableFSR"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Super Resolution"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Upscaler Mode"
                            android:textColor="#0055ff"
                            android:textSize="13sp" />
                        <Spinner
                            android:id="@+id/SPUpscalerMode"
                            android:layout_width="120dp"
                            android:layout_height="36dp"
                            android:background="@android:color/transparent" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/LBLSharpnessHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Sharpness"
                        android:textColor="#0055ff"
                        android:textSize="13sp" />
                    <com.winlator.cmod.widget.SeekBar
                        android:id="@+id/SBSharpness"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        app:maxValue="100"
                        app:minValue="0"
                        app:step="1" />

                    <View
                        android:id="@+id/VPostFXDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="2dp"
                        android:background="#33FFFFFF" />
                    <LinearLayout
                        android:id="@+id/LLPostFXOptions"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Post Effect"
                            android:textColor="#0055ff"
                            android:textSize="13sp" />
                        <Spinner
                            android:id="@+id/SPPostFXMode"
                            android:layout_width="130dp"
                            android:layout_height="36dp"
                            android:background="@android:color/transparent" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/SPColorMode"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
                <com.winlator.cmod.ui.ReshadeSidebarPanelView
                    android:id="@+id/LLSubReshade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/sidebar_card"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ReShade"
                            android:textColor="?attr/ingameSidebarOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Effect"
                            android:textColor="?attr/ingameSidebarOnSurfaceVariant"
                            android:textSize="12sp" />

                        <com.winlator.cmod.ui.ModernEffectSpinner
                            android:id="@+id/SPReshadeEffect"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="2dp"
                            android:background="@android:color/transparent"
                            android:gravity="start|center_vertical" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Strength"
                                android:textColor="?attr/ingameSidebarOnSurfaceVariant"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/TVReshadeStrengthValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="65%"
                                android:textColor="?attr/ingameSidebarPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/SBReshadeStrength"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:max="100"
                            android:progress="65" />
                    </LinearLayout>
                </com.winlator.cmod.ui.ReshadeSidebarPanelView>

                <LinearLayout
                    android:id="@+id/LLFrameGenOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/sidebar_card"
                    android:padding="12dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Frame Generation"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <Spinner
                        android:id="@+id/SPFrameGenFPS"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/sidebar_spinner" />
                    <TextView
                        android:id="@+id/LBLFrameGenFlowScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Flow Scale"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                    <com.winlator.cmod.widget.SeekBar
                        android:id="@+id/SBFrameGenFlowScale"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        app:minValue="0.25"
                        app:maxValue="1.0"
                        app:step="0.01" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/BTSaveGraphicsPreset"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/sidebar_action">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save Preset"
                        android:textColor="#DDF6FF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/LLSubScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/LLSubInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/LLSubFPS"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/LLSubTaskManager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/LLSubMouse"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

