<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:background="#000000">

        <LinearLayout
            android:id="@+id/BTItemGraphics"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_gpu"
                app:tint="#0055ff" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/BTItemScreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_effects"
                app:tint="#0055ff" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/BTItemInput"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/icon_mouse"
                app:tint="#0055ff" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/BTItemFPS"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_performance"
                app:tint="#0055ff" />
        </LinearLayout>

        <View
            android:layout_width="38dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/sidebar_field" />

        <LinearLayout
            android:id="@+id/BTItemTaskManager"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_task_manager"
                app:tint="#0055ff" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/BTItemPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_nav_icon_bg">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/icon_pause"
                app:tint="#0055ff" />
        </LinearLayout>

        <TextView
            android:id="@+id/TVPause"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/BTItemMouse"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/BTItemExit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/sidebar_exit">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_sidebar_power"
                app:tint="#FF5252" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@drawable/sidebar_field" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/sidebar_panel_bg"
        android:elevation="8dp"
        android:paddingStart="18dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/LLSubGraphics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/LLSubScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/LLSubInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/LLSubFPS"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/LLSubTaskManager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/LLSubMouse"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

