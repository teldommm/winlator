<?xml version="1.0" encoding="utf-8"?>
<!--
  MainActivity layout: a single ComposeView. Everything — tabs, portrait bottom nav, detail
  screens — is drawn by MainShell (ui/shell/MainShell.kt, ShellDetails.kt). The native Toolbar
  and the FLFragmentContainer fragment back stack are gone.

  The root keeps the DrawerLayout id because WinZTheme's ApplyWindowBackground paints it.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/DrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="false">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/MainShellCompose"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
