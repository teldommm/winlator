<?xml version="1.0" encoding="utf-8"?>
<!--
  The entire in-game sidebar is a single Compose composition (IngameSidebar.kt): card
  background/outline/elevation, rail, and all five panels. Panel identity is still
  R.id.LLSubXxx, declared as plain ids in values/ids_sidebar.xml. Colors come from WinZTheme;
  the activity has no native widgets left that would need an XML theme overlay.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/IngameSidebarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/IngameSidebarCompose"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
