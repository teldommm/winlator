<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Applied to XServerDisplayActivity's theme by IngameSidebarThemeLayout. The sidebar
      itself no longer reads anything from here — it is fully Compose and takes every color
      from WinZTheme. What's left are only the platform attrs that native widgets in the
      activity inherit. The former ingameSidebar* custom attrs were removed together with
      their last consumers (sidebar_panel_bg.xml and the unused widget/SeekBar.java).
    -->
    <style name="IngameSidebarTheme_White">
        <item name="android:textColorPrimary">#18191D</item>
        <item name="android:textColorSecondary">#60636B</item>
        <item name="android:colorAccent">#23252B</item>
        <item name="colorAccent">#23252B</item>
        <item name="colorControlNormal">#60636B</item>
        <item name="colorControlActivated">#23252B</item>
    </style>

    <style name="IngameSidebarTheme_Black">
        <item name="android:textColorPrimary">#F2F2F4</item>
        <item name="android:textColorSecondary">#85878C</item>
        <item name="android:colorAccent">#D9DDE3</item>
        <item name="colorAccent">#D9DDE3</item>
        <item name="colorControlNormal">#85878C</item>
        <item name="colorControlActivated">#D9DDE3</item>
    </style>

    <style name="IngameSidebarTheme_Amoled">
        <item name="android:textColorPrimary">#F7F7F7</item>
        <item name="android:textColorSecondary">#858585</item>
        <item name="android:colorAccent">#EDEDED</item>
        <item name="colorAccent">#EDEDED</item>
        <item name="colorControlNormal">#858585</item>
        <item name="colorControlActivated">#EDEDED</item>
    </style>
</resources>
