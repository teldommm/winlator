<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Values below are kept in lockstep with WinZTheme.kt's WhiteColors/BlackColors/AmoledColors
      (background, surface, outlineVariant) rather than being their own separate palette. The
      The floating content panel's shared background (sidebar_panel_bg, now also the outer
      IngameSidebarCard's background) is the only still-live consumer of ingameSidebarSurface/
      ingameSidebarOutline — the rail paints ingameSidebarSurfaceVariant as a plain fill now
      (see left_sidebar.xml), no longer its own rounded sidebar_rail_bg shape.
    -->
    <style name="IngameSidebarTheme_White">
        <item name="ingameSidebarBackground">#F5F6F8</item>
        <item name="ingameSidebarSurface">#E6FFFFFF</item>
        <item name="ingameSidebarSurfaceVariant">#E8E9ED</item>
        <item name="ingameSidebarOnSurface">#18191D</item>
        <item name="ingameSidebarOnSurfaceVariant">#60636B</item>
        <item name="ingameSidebarPrimary">#23252B</item>
        <item name="ingameSidebarPrimaryContainer">#E1E3E8</item>
        <item name="ingameSidebarOutline">#D1D3D8</item>
        <item name="ingameSidebarPanelTranslucent">#E6FFFFFF</item>
        <item name="android:textColorPrimary">#18191D</item>
        <item name="android:textColorSecondary">#60636B</item>
        <item name="android:colorAccent">#23252B</item>
        <item name="colorAccent">#23252B</item>
        <item name="colorControlNormal">#60636B</item>
        <item name="colorControlActivated">#23252B</item>
    </style>

    <style name="IngameSidebarTheme_Black">
        <item name="ingameSidebarBackground">#1C1D23</item>
        <item name="ingameSidebarSurface">#E626272F</item>
        <item name="ingameSidebarSurfaceVariant">#1A1A20</item>
        <item name="ingameSidebarOnSurface">#F2F2F4</item>
        <item name="ingameSidebarOnSurfaceVariant">#85878C</item>
        <item name="ingameSidebarPrimary">#D9DDE3</item>
        <item name="ingameSidebarPrimaryContainer">#1A1B1F</item>
        <item name="ingameSidebarOutline">#242423</item>
        <item name="ingameSidebarPanelTranslucent">#E626272F</item>
        <item name="android:textColorPrimary">#F2F2F4</item>
        <item name="android:textColorSecondary">#85878C</item>
        <item name="android:colorAccent">#D9DDE3</item>
        <item name="colorAccent">#D9DDE3</item>
        <item name="colorControlNormal">#85878C</item>
        <item name="colorControlActivated">#D9DDE3</item>
    </style>

    <style name="IngameSidebarTheme_Amoled">
        <item name="ingameSidebarBackground">#000000</item>
        <item name="ingameSidebarSurface">#E6050505</item>
        <item name="ingameSidebarSurfaceVariant">#0D0D0D</item>
        <item name="ingameSidebarOnSurface">#F7F7F7</item>
        <item name="ingameSidebarOnSurfaceVariant">#858585</item>
        <item name="ingameSidebarPrimary">#EDEDED</item>
        <item name="ingameSidebarPrimaryContainer">#101010</item>
        <item name="ingameSidebarOutline">#202020</item>
        <item name="ingameSidebarPanelTranslucent">#E6050505</item>
        <item name="android:textColorPrimary">#F7F7F7</item>
        <item name="android:textColorSecondary">#858585</item>
        <item name="android:colorAccent">#EDEDED</item>
        <item name="colorAccent">#EDEDED</item>
        <item name="colorControlNormal">#858585</item>
